# 复制为 .env 并填写；.env 不要提交到 Git（权限建议 600）
# 生成随机密钥：openssl rand -hex 32

PUBLIC_BASE_URL=http://your-server-ip
HTTP_PORT=80

# Kaizen 的 Bearer Token（写接口与 /agui 对话使用；控制台第一次写操作时会提示输入）
KAIZEN_API_KEY=
# 看板只读接口是否匿名可看（内网可设 true）
KAIZEN_DASHBOARD_PUBLIC=false
# 首次启动写入演示数据（120 个历史案例 + 6 个进行中案例）；接入真实 MES/YMS 后改为 false
KAIZEN_SEED_DEMO=true
# DBOS 夜间学习任务（cron，北京时间）；留空关闭
KAIZEN_NIGHTLY_CRON=0 2 * * *
# RSI：首次写入演示数据后自动跑一次冷启动基准 + 一次在线探索；课程 agent 可用不同模型家族（如 qwen4-max）
KAIZEN_RSI_ON_STARTUP=true
KAIZEN_RSI_CURRICULUM_MODEL=
# RSI 练习题的并行进程数（默认 CPU 核数 - 2，最多 8；0 = 不用进程池，内存紧张的小机器可设为 0 或 2）
# KAIZEN_RSI_WORKERS=2

# ── 大模型（OpenAI 兼容）──────────────────────────────
# DeepSeek（默认）：deepseek-v4-pro 质量优先 / deepseek-flash 成本优先
#   注意：deepseek-chat / deepseek-reasoner 已于 2026-07-24 下线
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4-pro
# 通义千问：
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen4-max
# 本地私有化（vLLM / SGLang 部署 Qwen3.8 等开源权重）：
# LLM_BASE_URL=http://your-gpu-server:8000/v1
# LLM_MODEL=Qwen3.8-27B

# 可选：向量检索（不填则只用 BM25）
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# 可选：PostgreSQL（docker compose --profile postgres up -d）
# POSTGRES_PASSWORD=
# KAIZEN_DATABASE_URL=postgresql+psycopg://kaizen:<POSTGRES_PASSWORD>@postgres:5432/kaizen
